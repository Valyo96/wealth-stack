# Copy to mobile/.env (or use scripts/start-mobile.ps1).
# Restart Expo after changing this file (env is read at Metro startup).

# --- Physical phone (Expo Go, same Wi‑Fi as PC) ---
# Replace with your PC's LAN IPv4 from `ipconfig` (Wi‑Fi adapter), not 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080

# --- Android emulator only (maps host machine localhost) ---
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# --- iOS simulator (Mac) ---
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
